# Copy to teamserver/.env and fill in. docker compose reads it from this folder. Never commit the real .env.

# The public name of your team server. Its DNS must point at this host (ports 80 and 443 open) for HTTPS.
TEAMSERVER_DOMAIN=team.example.com
# The base URL used in invite links. Normally https:// plus the domain above.
TEAMSERVER_URL=https://team.example.com

# Notification email (optional). Without SMTP_HOST the bell in the app still works; email is just not offered.
TEAMSERVER_SMTP_HOST=
TEAMSERVER_SMTP_PORT=587
TEAMSERVER_SMTP_USER=
TEAMSERVER_SMTP_PASSWORD=
TEAMSERVER_SMTP_FROM=
# 1 = STARTTLS (the default). 0 only for a relay on the same host or a private network.
TEAMSERVER_SMTP_STARTTLS=1

# Leave off on a server people reach over the internet: 1 lets members point webhooks at your private network.
TEAMSERVER_ALLOW_PRIVATE_WEBHOOKS=0

# Server publishing (optional, OFF by default). Only needed if the team wants the server to publish scheduled SoMe
# posts while every Mac is closed. Make one with:
#   docker compose run --rm --no-deps teamserver python3 -m teamserver vault new-key
# at least 32 characters. It is never stored in the database or in backups: keep a copy in a password manager.
# Losing it means uploading the channel keys again from Studio. See README.md, "Server publishing".
# TEAMSERVER_MASTER_KEY=
